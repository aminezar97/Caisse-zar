{
  "name": "zarouali-caisse",
  "version": "1.0.0",
  "description": "Zarouali Caisse - POS / Supermarket Management",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "web": "echo Web files are in www",
    "electron": "electron .",
    "electron:build": "electron-builder --win nsis portable",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.zarouali.caisse",
    "productName": "Zarouali Caisse",
    "artifactName": "Zarouali-Caisse-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zarouali Caisse",
      "deleteAppDataOnUninstall": false
    }
  }
}
