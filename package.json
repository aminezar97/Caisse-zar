{
  "name": "zarouali-caisse",
  "version": "1.0.0",
  "description": "Zarouali Caisse - POS / Supermarket Management",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "web": "echo Web files are in www",
    "electron": "electron .",
    "electron:build": "electron-builder --win nsis portable",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "assets:generate": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.zarouali.caisse",
    "productName": "Zarouali Caisse",
    "artifactName": "Zarouali-Caisse-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": ["AppImage"],
      "category": "Office"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": ["dmg"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zarouali Caisse",
      "deleteAppDataOnUninstall": false
    }
  }
}
