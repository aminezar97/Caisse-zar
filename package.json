{
  "name": "zarouali-caisse",
  "version": "1.0.0",
  "private": true,
  "description": "ZAROUALI CAISSE - offline Android POS built with Capacitor",
  "scripts": {
    "prepare": "node scripts/prepare-offline.js",
    "build": "npm run prepare",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android": "npx cap open android",
    "apk:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "apk:release": "npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "html5-qrcode": "2.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "main": "main.js",
  "build": {
    "appId": "com.zarouali.caisse",
    "productName": "Caisse-zar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}